{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DiskGuard",
  "version": "0.1.0",
  "identifier": "io.github.kaikaikaiser.diskguard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DiskGuard · 磁盘访问控制",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
